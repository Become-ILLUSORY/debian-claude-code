# ===== 构建与镜像 =====
IMAGE_NAME=debian-pi-agent
IMAGE_TAG=latest
CONTAINER_NAME=pi-agent
DEBIAN_VERSION=trixie-slim
NODE_VERSION=22.23.3

# Pi / 飞书桥接版本（latest 或具体版本号，如 1.3.0 / 0.1.6）
PI_VERSION=latest
PI_REMOTE_FEISHU_VERSION=latest
# 1 = 把 pi-remote-feishu 注册为 Pi 扩展（TUI 的 /feishu 命令与 lark-cli 技能）
PI_FEISHU_EXTENSION=1

# 容器内用户（与宿主 uid/gid 一致，避免挂载目录权限问题）
DEV_UID=1000
DEV_GID=1000

# ===== 访问 =====
# SSH 密码（留空则不设置密码，改用公钥）
SSH_PASSWORD=debian
DEV_PASSWORD=debian
# SSH 端口映射（宿主:容器）
SSH_PORT=2222
# Pi 的工作目录（容器内路径，也是飞书会话的默认 cwd）
PI_WORKDIR=/workspace
# 宿主数据目录
DATA_DIR=./data

# ===== 飞书机器人 =====
# auto = 填了 appId/appSecret 才启动；1 = 强制启动；0 = 关闭
FEISHU_ENABLED=auto
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_NAME=Pi Agent
# 自定义配置路径（容器内）；留空则由上面的环境变量生成 ~/.pi/agent/feishu.json
FEISHU_CONFIG=
# shared-chat（整群共享一个会话）或 per-user（群内按人隔离）
FEISHU_GROUP_SCOPE=shared-chat
FEISHU_REQUIRE_MENTION=1
FEISHU_DM_ENABLED=1
FEISHU_GROUP_ENABLED=1
# 白名单，英文逗号分隔；留空表示不限制
FEISHU_ALLOW_USERS=
FEISHU_ALLOW_CHATS=
# stream-card / markdown / text
FEISHU_RENDERING_MODE=stream-card
# fatal|error|warn|info|debug|trace
FEISHU_LOG_LEVEL=info
FEISHU_DEBUG_EVENTS=0
FEISHU_MAX_UPLOAD_MB=20

# ===== 模型凭据（按需填写，Pi 会读取这些环境变量）=====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

TZ=Asia/Shanghai
