# 构建与运行
IMAGE_NAME=debian-claude-code
IMAGE_TAG=latest
DEBIAN_VERSION=trixie-slim

# 容器内用户（与宿主 uid/gid 一致，避免挂载目录权限问题）
DEV_UID=1000
DEV_GID=1000

# SSH 密码（留空则不设置密码，改用公钥）
SSH_PASSWORD=debian
DEV_PASSWORD=debian

# SSH 端口映射（宿主:容器）
SSH_PORT=2222

# cc-connect 管理界面端口
CC_MGMT_PORT=9820
CC_BRIDGE_PORT=9810

# 是否随容器启动 cc-connect（1 开启）
CC_CONNECT_ENABLED=1
